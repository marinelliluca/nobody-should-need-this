# Copy this file to .env and fill in real values.
# .env should be gitignored; .env.example is safe to commit.

# Authentication tokens
# - mandatory
APIFY_TOKEN=apify_api_123456789... replace with yours 
# - optional but welcomed
# HF_TOKEN=hf_123456789...

# Ollama HTTP endpoint. Leave unset to use the default in config.toml
# (http://localhost:11434).
OLLAMA_HOST=http://localhost:11434

# Override the model from config.toml if needed (e.g. for a different
# deployment or for benchmarking). Leave unset to use config.toml.
# OLLAMA_MODEL=llama3.1

# Persistent Chroma directory. If unset, the index is in-memory and
# rebuilt every session. Set this to keep embeddings on disk and skip
# re-embedding on subsequent runs.
CHROMA_DIR=./.chroma

# Optional: path to the config file. Defaults to ./config.toml unless 
# changed here explicitely.
# RAG_CONFIG_PATH=./config.toml
